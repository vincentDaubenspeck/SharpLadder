root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 2

[*.cs]
indent_size = 4

# The solution format is tab-indented by the SDK that writes it.
[*.sln]
indent_style = tab

# shfmt reads these for shell scripts, including the extensionless hooks.
[*.sh]
shell_variant = posix
switch_case_indent = true
space_redirects = true

[tools/hooks/*]
shell_variant = posix
switch_case_indent = true
space_redirects = true

# NuGet writes lock files without a final newline; they are committed exactly as written.
[packages.lock.json]
insert_final_newline = false

# Upstream licence texts are kept byte for byte, so no text rule may rewrite them.
[web/assets/licences/*/OFL.txt]
charset = unset
end_of_line = unset
insert_final_newline = unset
trim_trailing_whitespace = unset
indent_style = unset
indent_size = unset
