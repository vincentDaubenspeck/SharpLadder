{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://sharpladder.com/schema/content.schema.json",
  "oneOf": [{ "$ref": "#/definitions/probe" }, { "$ref": "#/definitions/other" }],
  "definitions": {
    "probe": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "cells", "value", "steps"],
      "properties": {
        "type": { "const": "probe" },
        "cells": {
          "type": "array",
          "items": { "$ref": "body.schema.json#/definitions/cell" }
        },
        "value": { "$ref": "body.schema.json#/definitions/value" },
        "inline": { "oneOf": [{ "type": "integer" }, { "type": "string" }] },
        "mark": { "$ref": "body.schema.json#/definitions/markOrNone" },
        "spare": {
          "oneOf": [
            { "$ref": "body.schema.json#/definitions/copy" },
            { "$ref": "body.schema.json#/definitions/write" },
            { "type": "null" }
          ]
        },
        "steps": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "body.schema.json#/definitions/step" }
        },
        "slots": {
          "type": "array",
          "minItems": 1,
          "maxItems": 3,
          "items": { "$ref": "body.schema.json#/definitions/slot" }
        },
        "label": { "$ref": "body.schema.json#/definitions/label" },
        "index": { "$ref": "body.schema.json#/definitions/index" },
        "maybe": {
          "oneOf": [
            { "type": "null" },
            { "$ref": "body.schema.json#/definitions/value" }
          ]
        }
      }
    },
    "other": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type"],
      "properties": { "type": { "const": "other" } }
    }
  }
}
