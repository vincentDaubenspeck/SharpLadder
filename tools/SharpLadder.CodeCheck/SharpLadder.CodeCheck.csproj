<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <OutputType>Exe</OutputType>
    <!-- Both backends call the OS through LibraryImport, whose generated code is unsafe. -->
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <!-- Roslyn is a library here; its package must not add build logic to this build. -->
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp" ExcludeAssets="analyzers;build;buildTransitive" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../SharpLadder.Content/SharpLadder.Content.csproj" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="SharpLadder.CodeCheck.Tests" />
  </ItemGroup>
</Project>
