{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://sharpladder.com/schema/asset-licence.schema.json",
  "title": "Asset licence inventory",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "allowedLicences", "noticesContract", "assets"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "allowedLicences": { "const": ["OFL-1.1"] },
    "noticesContract": { "$ref": "#/definitions/noticesContract" },
    "assets": {
      "type": "array",
      "items": { "$ref": "#/definitions/asset" }
    }
  },
  "definitions": {
    "text": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[^\\s](?:[^\\r\\n]*[^\\s])?$"
    },
    "id": {
      "type": "string",
      "maxLength": 64,
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
    },
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "relativePath": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200,
      "pattern": "^[A-Za-z0-9_.@\\[\\],+-]+(?:/[A-Za-z0-9_.@\\[\\],+-]+)*$"
    },
    "noticesContract": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "assetsAreNoticesSource",
        "servedWithEachShippedAsset",
        "siteLicenceGrantsExcludeAssets",
        "consumer",
        "consumerReads"
      ],
      "properties": {
        "assetsAreNoticesSource": { "const": true },
        "servedWithEachShippedAsset": { "const": ["copyright", "licenceText"] },
        "siteLicenceGrantsExcludeAssets": { "const": true },
        "consumer": { "const": "notices-page-generator" },
        "consumerReads": { "const": "web/assets/licences/asset-inventory.json" }
      }
    },
    "originalFile": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "acquisitionPath", "sha256"],
      "properties": {
        "id": { "$ref": "#/definitions/id" },
        "acquisitionPath": { "$ref": "#/definitions/relativePath" },
        "sha256": { "$ref": "#/definitions/sha256" }
      }
    },
    "licenceText": {
      "type": "object",
      "additionalProperties": false,
      "required": ["sourcePath", "sha256", "distributionPath"],
      "properties": {
        "sourcePath": { "$ref": "#/definitions/relativePath" },
        "sha256": { "$ref": "#/definitions/sha256" },
        "distributionPath": {
          "oneOf": [
            { "$ref": "#/definitions/relativePath" },
            { "type": "null" }
          ]
        }
      }
    },
    "transformation": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind"],
          "properties": { "kind": { "const": "none" } }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "tool", "version", "options", "inputs"],
          "properties": {
            "kind": { "const": "subset" },
            "tool": { "$ref": "#/definitions/text" },
            "version": { "$ref": "#/definitions/text" },
            "options": {
              "type": "array",
              "items": { "$ref": "#/definitions/text" }
            },
            "inputs": {
              "type": "array",
              "minItems": 1,
              "uniqueItems": true,
              "items": { "$ref": "#/definitions/id" }
            }
          }
        }
      ]
    },
    "distributedFile": {
      "type": "object",
      "additionalProperties": false,
      "required": ["distPath", "sha256", "fromOriginal"],
      "properties": {
        "distPath": { "$ref": "#/definitions/relativePath" },
        "sha256": { "$ref": "#/definitions/sha256" },
        "fromOriginal": { "$ref": "#/definitions/id" }
      }
    },
    "asset": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schemaVersion",
        "id",
        "family",
        "upstreamSource",
        "upstreamRevision",
        "upstreamTag",
        "originalFiles",
        "copyright",
        "licence",
        "licenceText",
        "reservedFontNames",
        "declarationHash",
        "renamedIdentity",
        "distributedFamilyName",
        "transformation",
        "distributedFiles",
        "shipped"
      ],
      "properties": {
        "schemaVersion": { "const": 1 },
        "id": { "$ref": "#/definitions/id" },
        "family": { "$ref": "#/definitions/text" },
        "upstreamSource": {
          "type": "string",
          "pattern": "^https://[A-Za-z0-9.-]+/[A-Za-z0-9_./-]+$"
        },
        "upstreamRevision": {
          "type": "string",
          "pattern": "^[0-9a-f]{40}$"
        },
        "upstreamTag": {
          "oneOf": [{ "$ref": "#/definitions/text" }, { "type": "null" }]
        },
        "originalFiles": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/definitions/originalFile" }
        },
        "copyright": { "$ref": "#/definitions/text" },
        "licence": { "const": "OFL-1.1" },
        "licenceText": { "$ref": "#/definitions/licenceText" },
        "reservedFontNames": {
          "type": "array",
          "uniqueItems": true,
          "items": { "$ref": "#/definitions/text" }
        },
        "declarationHash": {
          "description": "Lowercase hex SHA-256 over the UTF-8 bytes of licenceText.sha256 (its lowercase hex string, not the digest bytes) concatenated with JSON.stringify(reservedFontNames) in declared order; an edit-consistency tripwire, not proof of review.",
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "renamedIdentity": { "type": "boolean" },
        "distributedFamilyName": {
          "oneOf": [{ "$ref": "#/definitions/text" }, { "type": "null" }]
        },
        "transformation": { "$ref": "#/definitions/transformation" },
        "distributedFiles": {
          "type": "array",
          "items": { "$ref": "#/definitions/distributedFile" }
        },
        "shipped": { "type": "boolean" }
      },
      "if": { "properties": { "shipped": { "const": false } } },
      "then": {
        "properties": {
          "distributedFiles": { "maxItems": 0 },
          "distributedFamilyName": { "type": "null" },
          "renamedIdentity": { "const": false },
          "licenceText": {
            "properties": { "distributionPath": { "type": "null" } }
          }
        }
      },
      "else": {
        "properties": {
          "distributedFiles": { "minItems": 1 },
          "distributedFamilyName": { "type": "string" },
          "licenceText": {
            "properties": { "distributionPath": { "type": "string" } }
          }
        }
      }
    }
  }
}
