{
  "name": "sharpladder-web",
  "version": "0.0.0",
  "private": true,
  "license": "PolyForm-Noncommercial-1.0.0",
  "type": "module",
  "engines": {
    "node": "26.13.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "npm run lint:css && npm run lint && npm run typecheck && node build-guard/build.mjs",
    "typecheck": "tsc -p tsconfig.json && tsc -p tsconfig.browser.json && tsc -p tsconfig.type-tests.json && tsc -p tsconfig.harness.json",
    "lint": "eslint --max-warnings 0 .",
    "lint:css": "node stylelint/lint-production.js",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "node content-check/acceptance.ts",
    "test:browser": "node browser/run.mjs",
    "audit": "npm audit --audit-level=low",
    "lint:lockfile": "lockfile-lint --path package-lock.json --type npm --allowed-hosts npm --validate-https --validate-integrity",
    "lint:md": "cd .. && markdownlint-cli2",
    "lint:spell": "cd .. && git ls-files | cspell --no-progress --no-must-find-files --file-list stdin",
    "lint:comments": "cd .. && node web/lint-comments.js web tools",
    "license:check": "node license-check.js",
    "asset-licence:check": "node asset-licence-check.js",
    "overrides:check": "node dependency-overrides-check.js",
    "knip": "node knip/run.js",
    "check": "npm run lint:lockfile && npm run license:check && npm run overrides:check && npm run lint && npm run lint:css && npm run lint:comments && npm run format:check && npm run typecheck && npm test && npm run knip && npm run lint:md && npm run lint:spell"
  },
  "dependencies": {
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@eslint-community/eslint-plugin-eslint-comments": "4.8.1",
    "@eslint/js": "10.0.1",
    "@npmcli/arborist": "9.9.3",
    "@playwright/test": "1.65.0",
    "@testing-library/dom": "10.4.2",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@types/node": "26.6.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@typescript-eslint/parser": "8.72.1",
    "@vitejs/plugin-react": "6.2.1",
    "@webref/css": "8.7.8",
    "ajv": "6.15.0",
    "bin-links": "6.0.3",
    "cspell": "10.4.0",
    "css-tree": "3.2.1",
    "eslint": "10.14.0",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-jsx-a11y-x": "0.2.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-plugin-react-refresh": "0.5.7",
    "fonteditor-core": "2.6.3",
    "fontkit": "2.0.4",
    "globals": "17.14.0",
    "jsdom": "31.0.0",
    "knip": "6.44.1",
    "lib-font": "3.0.5",
    "licensee": "12.0.2",
    "lightningcss": "1.33.0",
    "lockfile-lint": "5.1.0",
    "markdownlint-cli2": "0.24.0",
    "npm-install-checks": "8.0.0",
    "npm-normalize-package-bin": "5.0.0",
    "parse5": "8.1.0",
    "postcss": "8.5.32",
    "postcss-selector-parser": "7.1.7",
    "postcss-value-parser": "4.2.0",
    "prettier": "3.9.10",
    "stylelint": "18.0.0",
    "stylelint-config-standard": "41.0.0",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.1",
    "vite": "8.3.6",
    "vitest": "5.1.0"
  },
  "overrides": {
    "glob": "14.0.3",
    "micromark-extension-math": {
      "katex": "0.18.2"
    },
    "minimatch": "11.0.5",
    "re2js": "2.8.8"
  },
  "packageManager": "npm@11.20.0"
}
