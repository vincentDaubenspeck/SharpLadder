<Project>
  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
  </PropertyGroup>

  <!-- Analyzers for every project; global references are private assets, never shipped. -->
  <ItemGroup>
    <GlobalPackageReference Include="AsyncFixer" Version="2.1.0" />
    <GlobalPackageReference Include="IDisposableAnalyzers" Version="4.0.8" />
    <GlobalPackageReference Include="Meziantou.Analyzer" Version="3.0.321" />
    <GlobalPackageReference Include="Microsoft.CodeAnalysis.BannedApiAnalyzers" Version="5.6.0" />
    <GlobalPackageReference Include="Microsoft.VisualStudio.Threading.Analyzers" Version="18.12.1" />
    <GlobalPackageReference Include="Roslynator.Analyzers" Version="5.0.1" />
    <!-- The prerelease line is the only one that understands current C# syntax. -->
    <GlobalPackageReference Include="StyleCop.Analyzers" Version="1.3.171-beta" />
  </ItemGroup>

  <!-- Test projects reference these explicitly. -->
  <ItemGroup>
    <PackageVersion Include="xunit.analyzers" Version="2.2.0" />
  </ItemGroup>
</Project>
